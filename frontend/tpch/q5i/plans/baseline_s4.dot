// Q5I S4 baseline plan — HashJoin chain over base tables, no merged index.
//
// S4 uses base tables only (no COLI split secondaries). Fairness vs S3.
//
// Key difference from Q5's S4: Invoice joins via a hash-built map
// (invoice_map{invoicekey → i_status}) probed per lineitem, and
// c_nationkey is fetched via a customer primary-index PK lookup at
// lineitem time (Rule 4: hash build carries PK only, not c_nationkey).
//
// Operator-framing rules (same as family_logical.dot and family_s3_physical.dot):
//
//   • "Probe X" and "Build X" are NEVER operator nodes — edge roles only.
//   • Operator class (HashJoin inner vs HashSemiJoin) decided by what
//     flows downstream — NOT by whether build payload is empty.
//   • Rule 4 (PK-only build payload): customer hash-build carries
//     custkey only; c_nationkey fetched via customer primary-index PK
//     lookup at lineitem time (not carried in the hash table).
//
// Filter pushdown:
//   • r_name = :1           → fused with TableScan(REGION) before NATION join.
//   • c_nationkey ∈ nation_set → fused with TableScan(CUSTOMER) before hash-build.
//   • o_orderdate ∈ window  → fused with TableScan(ORDERS) before hash-build.
//
// Post-pipeline operator chain (Rule 11 — shared S1–S4):
//   1. ⋉ supplier_nation_set[(c_nationkey, l_suppkey)]
//   2. HashAggregate by c_nationkey: nominal/realised/open/late
//   3. n_name = nation.lookup(c_nationkey) [PK lookup, ≤5 per query]
//   4. Sort by nominal_revenue DESC

digraph {
  rankdir=BT;

  // ─────────── Shared dimension subtree: RN = REGION ⋈ NATION ───────────
  s_reg [label="TableScan(REGION)\n+ Filter(r_name == :1)\n→ 1 regionkey",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  s_nat [label="TableScan(NATION)",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  rn    [label="HashJoin (inner)\nREGION ⋈ NATION\n  on n_regionkey = r_regionkey\nbuild payload = n_nationkey only\n(PK payload convention)",
         shape=box, style="filled,rounded", fillcolor="#E0F2F1"];

  s_reg -> rn [label="build (filtered)"];
  s_nat -> rn [label="probe"];

  // ─────────── CUSTOMER ⋈ RN (inner) → custkey hash-build (PK only) ───────────
  s_cust  [label="TableScan(CUSTOMER)\n+ Filter(c_nationkey ∈ nation_set)",
           shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_cust [label="HashJoin (inner)\nCUSTOMER ⋈ RN\n  on c_nationkey = n_nationkey\nper match: nation.lookup(c_nationkey) → n_name\n  [PK lookup, ~5/query, cached in nationkey_to_name]\nbuild payload = custkey only (PK; Rule 4)\n→ cust_set{custkey}",
           shape=box, style="filled,rounded", fillcolor="#E8F0FE"];

  rn     -> hj_cust [label="build (nation_set,\nPK-only)"];
  s_cust -> hj_cust [label="probe (nation-filtered)"];

  // ─────────── ORDERS ⋈ cust_set (inner) → orderkey hash-build (PK only) ───────────
  s_ord  [label="TableScan(ORDERS)\n+ Filter(o_orderdate ∈ window)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_ord [label="HashJoin (inner)\nORDERS ⋈ cust_set\n  on o_custkey = custkey\nbuild payload = orderkey only (PK)\n→ orders_set{orderkey}",
          shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  hj_cust -> hj_ord [label="build (cust_set)"];
  s_ord   -> hj_ord [label="probe (date-filtered)"];

  // ─────────── INVOICE → hash-build on invoicekey (PK only, Rule 4) ───────────
  s_inv  [label="TableScan(INVOICE)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  hb_inv [label="HashBuild\nINVOICE\n  on i_invoicekey\n→ invoice_set{invoicekey}\n(PK only; Rule 4 — i_status fetched\nvia PK lookup at probe time)",
          shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  s_inv -> hb_inv;

  // ─────────── LINEITEM ⋈ orders_set → then ⋈ invoice_set ───────────
  s_lin  [label="TableScan(LINEITEM)\n[base table, sorted by l_orderkey]",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_lin [label="HashJoin (inner)\n<cust-ord> ⋈ LINEITEM\n  on l_orderkey = orderkey\nper surviving lineitem:\n  customer.lookup(o_custkey) → c_nationkey\n    [PK lookup; Rule 4 — not hash-built]\n  nationkey_to_name[c_nationkey] → n_name\n    [cache hit; built at hj_cust time]\nsurvivors carry: l_invoicekey, l_suppkey,\n  l_extendedprice, l_discount, n_name",
          shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  hj_inv [label="HashJoin (inner)\n<cust-ord-lin> ⋈ invoice_set\n  on l_invoicekey = i_invoicekey\nper match: invoice.lookup(l_invoicekey)\n  → i_status  [PK lookup; Rule 4]\n→ emit {n_name, l_suppkey,\n         l_extendedprice, l_discount,\n         i_status}",
          shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  hj_ord -> hj_lin [label="build (orders_set)"];
  s_lin  -> hj_lin [label="probe"];
  hj_lin -> hj_inv [label="probe"];
  hb_inv -> hj_inv [label="build (invoice_set,\nPK-only)"];

  // ─────────── SUPPLIER ⋉ RN (semi-join) ───────────
  s_sup  [label="TableScan(SUPPLIER)",
          shape=box, style=filled, fillcolor="#E0F2F1"];
  sj_sup [label="HashSemiJoin\nSUPPLIER ⋉ RN\n  on s_nationkey = n_nationkey\nsurvivors projected to\n  (s_nationkey, s_suppkey)\n[supplier_nation_set]",
          shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  rn    -> sj_sup [label="build (nation_set,\nPK-only)"];
  s_sup -> sj_sup [label="probe"];

  // ─────────── Post-pipeline (Rule 11) ───────────
  sj_col_sup [label="HashSemiJoin\n<cust-ord-lin-inv> ⋉ supplier_nation_set\n  on (c_nationkey, l_suppkey)\n     = (s_nationkey, s_suppkey)\nfuses: SUPPLIER ⋉ RN,\n   cross-eq c_nationkey = s_nationkey,\n   suppkey equi-join",
              shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  agg [label="HashAggregate\ngroup = [n_name],\n  nominal  += revenue         (all)\n  realised += revenue if P\n  open     += revenue if O\n  late     += revenue if L\n[≤5 entries; n_name resolved at hj_cust]",
       shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  sort [label="Sort(nominal_revenue DESC)\n[std::sort, ~5 rows]",
        shape=box, style=filled, fillcolor="#E6F4EA"];

  hj_inv     -> sj_col_sup [label="probe (per-lineitem)"];
  sj_sup     -> sj_col_sup [label="build\n(supplier_nation_set)"];
  sj_col_sup -> agg;
  agg        -> sort;
}
