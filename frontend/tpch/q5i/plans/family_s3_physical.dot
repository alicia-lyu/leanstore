// Q5I S3 physical plan — single COLIGroupWalk over the 4-table COLI
// MergedAdapter, plus the shared RN dimension subtree computed pre-walk.
//
// Why one operator replaces five: the COLI MI co-locates CUSTOMER,
// INVOICE, ORDERS, and LINEITEM by custkey using tagged keys. Within a
// custkey group, byte-lex order is:
//
//     customer(t=1) → invoice*(t=2) → (orders(t=3) → lineitem*(t=4))+
//
// Invoices therefore appear BEFORE any orders/lineitems, so the invoice
// buffer is guaranteed complete when on_lineitem fires (CONVENTIONS.md
// Rule 10 Pattern B — buffer full records, extract at assembly time).
//
// Visitor hooks (CONVENTIONS.md Rule 10):
//
//   on_customer  → semi-join: c_nationkey ∈ nation_set?
//                  → false (SkipGroup) suppresses all remaining hooks
//                    for this custkey group (Rule 10 — semi-join tables
//                    use skip-group only; no buffering)
//
//   on_invoice   → equi-join (Rule 10 Pattern B): append full
//                  invoice_coli_t to invoice_buf[]; cleared at each
//                  new custkey group. i_status extracted at on_lineitem
//                  assembly time, not during this hook.
//
//   on_orders    → semi-join: o_orderdate ∉ [date, date+1y)?
//                  → SkipOrder suppresses lineitems for this order
//                    (Rule 10 — semi-join tables skip only; no buffering)
//
//   on_lineitem  → look up invoice_buf[key.invoicekey] → full record
//                  → extract i_status
//                  → emit assembled record to post-pipeline chain:
//                    {c_nationkey, l_suppkey, l_extendedprice,
//                     l_discount, i_status}
//
// The walker emits one record per qualifying lineitem; it does NOT
// aggregate or apply the supplier semi-join (both are post-pipeline
// per Rule 11). The per-query invoice buffer is cleared at each
// on_group_end before the next custkey group begins.
//
// Post-pipeline operator chain (Rule 11 — outside walker, shared S1–S4):
//   1. ⋉ supplier_nation_set[(c_nationkey, l_suppkey)]
//   2. HashAggregate by c_nationkey: route revenue by i_status
//   3. n_name = nation.lookup(c_nationkey) [PK lookup, ≤5 per query]
//   4. Sort by nominal_revenue DESC
//
// C++ implementation map (q5i/query.tpp::query_by_merged):
//
//   coli_group_walk<Backend>(merged_coli, COLIGroupWalkVisitor{
//       nation_set,           // unordered_set<n_nationkey>
//       supplier_nation_set,  // unordered_set<tuple<n_nationkey, s_suppkey>>
//       invoice_buf,          // vector<invoice_coli_t>, cleared per group
//       params})
//
//     Visitor::on_customer  → c_nationkey ∈ nation_set? SkipGroup
//     Visitor::on_invoice   → invoice_buf.push_back(full record)
//     Visitor::on_orders    → o_orderdate ∈ window? else SkipOrder
//     Visitor::on_lineitem  → invoice_buf[key.invoicekey] → i_status
//                           → emit {c_nationkey, l_suppkey,
//                                   l_extendedprice, l_discount,
//                                   i_status} to OutClass
//     Visitor::on_group_end → invoice_buf.clear()
//
//   OutClass (post-pipeline):
//     ⋉ supplier_nation_set probe → aggregate → nation lookup → sort

digraph {
  rankdir=BT;

  // ─────────── Pre-walk: RN = REGION ⋈ NATION ───────────
  s_reg [label="TableScan(REGION) + Filter(r_name == :1)\n→ regionkey",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  s_nat [label="TableScan(NATION)",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  rn    [label="HashJoin (inner)\nREGION ⋈ NATION\n  on n_regionkey = r_regionkey\nbuild payload = n_nationkey only\n(PK payload convention)\n→ nation_set",
         shape=box, style="filled,rounded", fillcolor="#E0F2F1"];

  s_reg -> rn [label="build (filtered)"];
  s_nat -> rn [label="probe"];

  // ─────────── Pre-walk: SUPPLIER ⋉ RN ───────────
  s_sup  [label="TableScan(SUPPLIER)",
          shape=box, style=filled, fillcolor="#E0F2F1"];
  sj_sup [label="HashSemiJoin\nSUPPLIER ⋉ RN\n  on s_nationkey = n_nationkey\nsurvivors projected to\n  (s_nationkey, s_suppkey)\n→ supplier_nation_set",
          shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  rn    -> sj_sup [label="build (nation_set,\nPK-only)"];
  s_sup -> sj_sup [label="probe"];

  // ─────────── COLI MI ───────────
  mi [label="MergedScanner(MI_COLI)\n= [customer_coli_t, invoice_coli_t,\n   orders_coli_t, lineitem_coli_t]\nbyte-lex per custkey group:\n  customer(t=1) → invoice*(t=2)\n  → (orders(t=3) → lineitem*(t=4))+\n[loaded UNFILTERED — params apply at walk time]",
      shape=box3d, style=filled, fillcolor="#E8F0FE"];

  walk [label="COLIGroupWalk(Visitor)\nsubsumes COLI pipeline:\n  • on_customer: c_nationkey ∈ nation_set?\n      → SkipGroup if absent (semi-join,\n        Rule 10 — no buffering)\n      on match: nation.lookup(c_nationkey)\n        → n_name [PK lookup, ~5/query,\n          cached in nationkey_to_name]\n  • on_invoice:  append full invoice_coli_t\n      to invoice_buf[] (equi-join,\n      Rule 10 Pattern B — full record;\n      i_status extracted at on_lineitem)\n  • on_orders:   o_orderdate ∈ window?\n      → SkipOrder if absent (semi-join,\n        Rule 10 — no buffering)\n  • on_lineitem: invoice_buf[key.invoicekey]\n      → i_status; emit assembled record:\n      {n_name, l_suppkey,\n       l_extendedprice, l_discount, i_status}\n  • on_group_end: invoice_buf.clear()",
       shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  // ─────────── Post-pipeline (Rule 11) ───────────
  sj_col_sup [label="HashSemiJoin\n<pipeline> ⋉ supplier_nation_set\n  on (c_nationkey, l_suppkey)\nfuses: SUPPLIER ⋉ RN,\n   cross-eq c_nationkey = s_nationkey,\n   suppkey equi-join",
              shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  agg [label="HashAggregate\ngroup = [n_name],\n  nominal  += revenue         (all)\n  realised += revenue if P\n  open     += revenue if O\n  late     += revenue if L\n[n_name resolved at on_customer,\ncarried through pipeline]",
       shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  sort [label="Sort(nominal_revenue DESC)\n[std::sort, ~5 rows]",
        shape=box, style=filled, fillcolor="#E6F4EA"];

  // ─────────── Edges ───────────
  rn     -> walk [style=dashed, label="nation_set (build)\n[used by on_customer]"];
  mi     -> walk;
  walk   -> sj_col_sup;
  sj_sup -> sj_col_sup [label="build\n(supplier_nation_set)"];
  sj_col_sup -> agg;
  agg        -> sort;
}
