// Q10 family logical plan — shared by S1, S2, S3.
//
// Departs from Calcite's vanilla Q10 plan in two ways, mirroring Q3 /
// Q5's COL-family treatment:
//
//   1. Pipeline sort key is CUSTKEY, not ORDERKEY. ORDERS and
//      LINEITEM secondaries are extended with the custkey FD (orders
//      key `(custkey, orderkey)`, lineitem key
//      `(custkey, orderkey, linenumber)`) so the COL MI's natural
//      sort key is custkey. Per OPERATORS.md §1, the family logical
//      plan must match the COL MI's natural sort key.
//
//   2. NATION attaches as an **index nested-loop join** (Rule 13),
//      not as an in-memory dimension subtree. Q10 has no filter on
//      NATION (no region clause), so a nation_set hashset would be
//      degenerate (all 25 rows). Across all four storage structures,
//      `n_name` is resolved by a per-customer point lookup on the
//      NATION primary index at emit time. There is no nation_set,
//      no nation_name_map, no pre-materialised name array.
//
// The chain itself is identical in shape to Q3 / Q5: customer ×
// orders × lineitem in custkey-byte-lex order. Filter pushdown:
//
//   • o_orderdate ∈ [:d, :d + 3mo)  → fused with TableScan(ORDERS)
//   • l_returnflag = 'R'            → fused with TableScan(LINEITEM)
//
// FILTER PUSHDOWN: every parameterised filter is pushed as far down
// as possible, stopping ONLY at secondary structures. The COL MI,
// COL secondaries, and pipeline view are all loaded UNFILTERED.
// Neither the orderdate window (parameterised) nor `l_returnflag`
// (spec-hardcoded but kept live for view reusability across the
// hypothetical Q10-without-returns variant) is baked into any
// secondary; predicate hoisting per PLAYBOOK §3.5 step 7.
//
// AGGREGATION SHAPE: the shared family logical plan rolls revenue up
// **directly per c_custkey** in a single HashAggregate. The 6 other
// GROUP BY columns (c_name, c_acctbal, c_phone, c_address,
// c_comment, n_name — the last resolved via NATION INL) are FD on
// c_custkey and ride along on the aggregate row. This shape is the
// shared logical contract across S1 / S2 / S3.
//
//   S2-only anomaly — intermediate per-orderkey partial aggregate.
//   Because S2 hoists `o_orderdate` out of the view (the view loads
//   unfiltered) and the orderdate filter applies at *order*
//   granularity, S2's view-scan plan inserts a per-orderkey partial
//   SUM between the view scan and the per-customer SUM:
//     view scan → returnflag filter → SUM-per-orderkey →
//       filter[o_orderdate ∈ window] → SUM-per-c_custkey.
//   This is a physical-plan necessity of S2 alone — see
//   family_s2_anomaly comment block below — and is NOT part of the
//   logical shared plan. S1 / S3 / S4 apply the orderdate filter
//   inside the join chain itself, so the per-orderkey roll-up
//   collapses into the per-customer SUM at zero cost.
//
// Q10 has NO sibling sub-aggregate, NO region restriction, and NO
// supplier-side cross-equality. The MI benefit is purely §3.1.3
// hierarchical-prefix scan locality on the COL chain. NATION is a
// dimension lookup, not a chain participant.
//
// TopN(20) sits OUTSIDE the pipeline. S3's incremental top-20 sink
// (D2) is fed at the on_group_end boundary so the per-customer
// intermediate vector never materialises in full; logically the
// TopN node is unchanged.

digraph {
  rankdir=BT;

  // Logical joins (Rule 12):
  //   #1 CUSTOMER ⋈ ORDERS   on c_custkey  = o_custkey
  //   #2 ORDERS   ⋈ LINEITEM on o_orderkey = l_orderkey
  //   #3 CUSTOMER ⋈ NATION   on c_nationkey = n_nationkey
  //      — lowered to per-customer INL on NATION PK (Rule 13)

  // ─────────── Inside pipeline (custkey-sorted chain) ───────────
  s_cust [label="TableScan(CUSTOMER)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_ord  [label="TableScan(ORDERS)\n+ Filter(o_orderdate ∈ [:d, :d+3mo))",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_lin  [label="TableScan(LINEITEM)\n+ Filter(l_returnflag = 'R')",
          shape=box, style=filled, fillcolor="#E8F0FE"];

  joinB [label="#2 MergeJoin (inner)\nORDERS ⋈ LINEITEM\n  on (custkey, orderkey)\nstill custkey-sorted (FD via parent);\norders_sec: (custkey, orderkey)\nlineitem_sec: (custkey, orderkey, linenumber)",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];
  joinA [label="#1 MergeJoin (inner)\nCUSTOMER ⋈ <ord-line>\n  on custkey\nsorted on custkey;\ncustomer rows carry forward as join input,\nnon-aggregate output cols recovered at\nrecord-assembly time (PK-only build conv.)",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  // ─────────── Per-customer aggregation (single HashAggregate) ───────────
  agg_c [label="HashAggregate per c_custkey\n  revenue = SUM(l_extendedprice\n            * (1 - l_discount))\n  group key carries only c_custkey;\n  the 6 FD output cols\n  (c_name, c_acctbal, c_address,\n   c_phone, c_comment, c_nationkey)\n  are recovered at record-assembly\n  time via CUSTOMER PK lookup (Rule 13)",
         shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  // ─────────── NATION attachment: INL on PK at record assembly ───────────
  inl_n [label="#3 INL-Join NATION\n  probe.c_nationkey =\n    NATION.PK(n_nationkey)\n→ attaches n_name to each\n  per-customer aggregate row\n(no nation_set; no in-memory map)",
         shape=box, style="filled,rounded", fillcolor="#E0F2F1"];

  topn [label="TopN(20, revenue DESC)\n[bounded min-heap by revenue ASC,\n capacity 20; result is at most 20 rows]",
        shape=box, style=filled, fillcolor="#E6F4EA"];

  // ─────────── Edges (chain) ───────────
  s_ord  -> joinB [label="0"];
  s_lin  -> joinB [label="1"];

  s_cust -> joinA [label="0"];
  joinB  -> joinA [label="1"];

  joinA -> agg_c;
  agg_c -> inl_n;
  inl_n -> topn;

  // ─────────── S2-only anomaly note ───────────
  // S2 cannot apply o_orderdate inside the join chain — the view is
  // loaded unfiltered (predicate hoisting). The orderdate filter
  // therefore fires above the view scan, at order granularity, which
  // forces an intermediate per-orderkey SUM before the per-custkey
  // SUM:
  //
  //     view scan(q10_pipeline_view_t)
  //       → Filter(l_returnflag = 'R')
  //       → SUM-per-orderkey  (carries c_custkey forward as FD)
  //       → Filter(o_orderdate ∈ [:d, :d+3mo))
  //       → HashAggregate per c_custkey
  //       → (joins back into agg_c above)
  //
  // S1 / S3 / S4 apply the orderdate filter inside the join chain
  // (the walker / merge-join / hash-probe sees o_orderdate per
  // qualifying order) so no intermediate per-orderkey SUM exists.
  // The anomaly is purely an S2 physical-plan artefact.
}
