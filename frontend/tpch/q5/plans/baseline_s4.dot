// Q5 S4 baseline plan — HashJoin chain over base tables, no merged
// index. The "no co-location" reference point against which S1/S2/S3
// are compared.
//
// S4 uses base tables only; no col.split_* secondaries. Fairness vs S3.
//
// Operator-framing rules used throughout (also applies to
// family_logical.dot and family_s3_physical.dot):
//
//   • "Probe X" and "Build X" are NEVER operator nodes — they are
//     edge roles into a HashJoin/HashSemiJoin operator. The operator
//     node is the join; build/probe are labels on its input edges.
//   • Operator class (HashJoin inner vs HashSemiJoin) is decided by
//     what the joined record carries downstream — NOT by whether the
//     build payload happens to be empty.
//   • Sorted-then-seek loops are HashJoin lowerings (the build side
//     is sorted and the probe side is naturally sorted on the join
//     key, so per-build-row seek into the probe scanner is a
//     physical implementation of the hash join). Draw them as
//     HashJoin nodes; mention sorted-seek in a comment.
//
// Filter pushdown (specific fusions for S4):
//
//   • r_name = :1               → fused with TableScan(REGION) before
//                                  the NATION join's build.
//   • o_orderdate ∈ window       → fused with TableScan(ORDERS) before
//                                  ORDERS feeds its probe edge.
//
// PRIMARY-KEY PAYLOAD CONVENTION: every hash build carries only the
// build relation's primary key — no record content. Downstream
// consumers fetch additional columns via the primary index at
// consumption time. n_name is the canonical example: it is NOT in
// any intermediate build payload; the inner-join framing of
// CUSTOMER ⋈ RN authorizes fetching n_name anywhere downstream.
// Convention: lazy NATION PK lookup inside the HashAggregate, on
// first encounter of each new nationkey (~5 lookups per query,
// cached in the per-nationkey bucket).
//
// Asymmetry between the two fan-outs from RN:
//   CUSTOMER ⋈ RN is HashJoin (inner) — the joined record carries
//                                       n_nationkey forward; n_name
//                                       fetched lazily downstream.
//   SUPPLIER ⋉ RN is HashSemiJoin    — no NATION column flows
//                                       downstream from the supplier
//                                       arm; supplier survivors carry
//                                       only their own (s_nationkey,
//                                       s_suppkey).
//
// Per-orderkey c_nationkey caching during the LINEITEM hash-join's
// sorted-seek lowering: orders_set carries only the orderkey (Rule 4),
// so c_nationkey is recovered per orderkey transition via two chained
// INL probes (orders.lookup1 → customer.lookup1; Rule 13) and cached
// for the ~4 lineitems sharing that orderkey.
//
// Logical join numbering (Rule 12):
//   #1 CUSTOMER ⋈ NATION on c_nationkey = n_nationkey (RN inner-join)
//   #2 CUSTOMER ⋈ ORDERS on c_custkey   = o_custkey
//   #3 ORDERS   ⋈ LINEITEM on o_orderkey = l_orderkey
//   #4 SUPPLIER ⋉ NATION on s_nationkey = n_nationkey (semi)
//   #5 (LINEITEM × SUPPLIER) composite-key semi-join fusing the
//      cross-equality c_nationkey = s_nationkey and the suppkey
//      equi-join into one composite (s_nationkey, s_suppkey) probe.

digraph {
  rankdir=BT;

  // ─────────── Shared dimension subtree: RN = REGION ⋈ NATION ───────────
  s_reg [label="TableScan(REGION)\n+ Filter(r_name == :1)\n→ 1 regionkey",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  s_nat [label="TableScan(NATION)",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  rn    [label="HashJoin (inner)\nREGION ⋈ NATION\n  on n_regionkey = r_regionkey\nbuild payload = n_nationkey only\n(PK payload convention)",
         shape=box, style="filled,rounded", fillcolor="#E0F2F1"];

  s_reg -> rn [label="build (filtered)"];
  s_nat -> rn [label="probe"];

  // ─────────── CUSTOMER ⋈ RN (inner — n_name flows downstream) ───────────
  s_cust  [label="TableScan(CUSTOMER)",
           shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_cust [label="#1 HashJoin (inner)\nCUSTOMER ⋈ RN\n  on c_nationkey = n_nationkey\nbuild = nation_set (PK-only)\nsurvivors: cust_set<custkey>\n  (PK-only — Rule 4)\nc_nationkey recovered later via\n  customer.lookup1 at probe time",
           shape=box, style="filled,rounded", fillcolor="#E8F0FE"];

  rn     -> hj_cust [label="build (nation_set,\nPK-only)"];
  s_cust -> hj_cust [label="probe"];

  // ─────────── #2 ORDERS ⋈ CUSTOMER on c_custkey = o_custkey ───────────
  s_ord  [label="TableScan(ORDERS)\n+ Filter(o_orderdate ∈ window)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_ord [label="#2 HashJoin (inner)\nORDERS ⋈ cust_set\n  on o_custkey = c_custkey\nbuild = cust_set (PK-only)\nsurvivors: orders_set<orderkey>\n  (PK-only — Rule 4)",
          shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  hj_cust -> hj_ord [label="build (cust_set,\nPK-only)"];
  s_ord   -> hj_ord [label="probe (orderdate-filtered)"];

  // ─────────── #3 LINEITEM ⋈ ORDERS on l_orderkey = o_orderkey ───────────
  // Probe-side seek-on-miss lowering (CONVENTIONS Rule 3): LINEITEM is
  // naturally sorted by l_orderkey, so on a miss at orderkey K we seek
  // to {K+1, 0}. Per-orderkey transition recovers c_nationkey via two
  // chained INL probes (Rule 13).
  s_lin  [label="TableScan(LINEITEM)\n[naturally sorted by\n l_orderkey on base table]",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_lin [label="#3 HashJoin (inner)\nLINEITEM ⋈ orders_set\n  on l_orderkey = o_orderkey\nbuild = orders_set (PK-only)\nLowering: seek-on-miss to\n  {K+1, 0}; per-orderkey-transition\n  INL recovery (Rule 13):\n    orders.lookup1(K) → custkey\n    customer.lookup1(custkey)\n      → c_nationkey\n  cached for ~4 lineitems\n  of this order",
          shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  hj_ord -> hj_lin [label="build (orders_set,\nPK-only)"];
  s_lin  -> hj_lin [label="probe (seek-on-miss)"];

  // ─────────── SUPPLIER ⋉ RN (semi-join; no NATION column flows past) ───────────
  s_sup  [label="TableScan(SUPPLIER)",
          shape=box, style=filled, fillcolor="#E0F2F1"];
  sj_sup [label="#4 HashSemiJoin\nSUPPLIER ⋉ RN\n  on s_nationkey = n_nationkey\nsurvivors projected to\n  (s_nationkey, s_suppkey)\n  — composite key = PK of\n  restricted-supplier relation\n[supplier_nation_set]",
          shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  rn    -> sj_sup [label="build (nation_set,\nPK-only)"];
  s_sup -> sj_sup [label="probe"];

  // ─────────── COL × SUPPLIER composite-key semi-join (fuses cross-eq + suppkey) ───────────
  sj_col_sup [label="#5 HashSemiJoin\n<lin-join> ⋉ supplier_nation_set\n  on (c_nationkey, l_suppkey)\n     = (s_nationkey, s_suppkey)\nfuses: SUPPLIER ⋉ RN,\n   cross-eq c_nationkey = s_nationkey,\n   suppkey equi-join\nsurvivors carry c_nationkey,\n  l_extendedprice, l_discount",
              shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  hj_lin -> sj_col_sup [label="probe (per-lineitem)"];
  sj_sup -> sj_col_sup [label="build\n(supplier_nation_set)"];

  // ─────────── Aggregate (n_name fetched lazily inside) ───────────
  agg [label="HashAggregate\ngroup = [n_nationkey],\nrevenue = SUM(l_extendedprice\n          * (1 - l_discount))\nn_name fetched lazily on first sighting\nof each nationkey via NATION PK lookup\n(~5 lookups, cached in the bucket);\nbuckets drain to q5_agg_row_t directly",
       shape=box, style="filled,rounded", fillcolor="#FCE5CD"];
  sort [label="Sort(revenue DESC)\n[std::sort, ~5 rows]",
        shape=box, style=filled, fillcolor="#E6F4EA"];

  sj_col_sup -> agg;
  agg        -> sort;

}
