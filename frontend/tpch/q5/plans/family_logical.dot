// Q5 family logical plan — shared by S1, S2, S3.
//
// Departs from Calcite's vanilla Q5 plan in two key ways, mirroring
// Q3's COL-family treatment:
//
//   1. Pipeline sort key is CUSTKEY, not ORDERKEY. ORDERS and LINEITEM
//      secondaries are extended with the custkey FD (orders key
//      `(custkey, orderkey)`, lineitem key `(custkey, orderkey,
//      linenumber)`) so the COL MI's natural sort key is custkey.
//      Per OPERATORS.md §1, the family logical plan must match the COL
//      MI's natural sort key.
//
//   2. **Side dimension subtree (RN = REGION ⋈ NATION) fans out into
//      two symmetric semi-joins, framed as standard hash operations:**
//
//         RN shared dimension subtree
//         ───────────────────────────
//         • Filter(r_name = :1) → REGION
//         • HashJoin(REGION ⋈ NATION on n_regionkey = r_regionkey)
//             inner join; build payload = n_nationkey only
//             (primary-key payload convention — join key = PK of
//             surviving NATION rows; no other columns carried).
//             → RN result
//
//         Two symmetric fan-outs from RN, both framed as semi-joins:
//
//         Fan-out 1 — CUSTOMER ⋉ RN on c_nationkey = n_nationkey
//             (semi-join; no NATION column flows downstream;
//              surviving CUSTOMER rows carry only their own columns;
//              c_nationkey is preserved so the downstream composite-
//              key probe at lineitem time has it;
//              n_name fetched at emit time via NATION primary-index
//              lookup keyed on c_nationkey, ~5 lookups per query)
//
//         Fan-out 2 — SUPPLIER ⋉ RN on s_nationkey = n_nationkey
//             (semi-join; no NATION column flows downstream)
//             → Build(hashset on (s_nationkey, s_suppkey))
//                 composite key — effective PK of the restricted-
//                 supplier relation; no payload.
//                 Probed per-lineitem with (c_nationkey, l_suppkey):
//                 one lookup fuses SUPPLIER ⋉ RN with the cross-
//                 equality c_nationkey = s_nationkey and the natural
//                 join l_suppkey = s_suppkey.
//
//      All three structures (RN, CUSTOMER semi-join, SUPPLIER
//      composite build) are computed BEFORE the chain pipeline
//      starts. They have no chain-position; the chain consumes them
//      via lookups, not joins-up.
//
// The chain itself is identical in shape to Q3's: customer × orders ×
// lineitem in custkey-byte-lex order. Filter pushdown:
//
//   • CUSTOMER ⋉ RN on c_nationkey = n_nationkey → fused with
//                                       TableScan(CUSTOMER)
//                                       (semi-join; ~80% prune)
//   • o_orderdate ∈ window           → fused with TableScan(ORDERS)
//   • l_extendedprice * (1-l_discount) → per-lineitem accumulator input
//   • (c_nationkey, l_suppkey) probe  → per-lineitem composite-key
//                                       hashset probe; SKIP if absent
//                                       (fuses supplier semi-join,
//                                        cross-equality c_nationkey =
//                                        s_nationkey, and suppkey
//                                        equi-join in one lookup)
//
// Q5 has NO sibling sub-aggregate. The MI benefit is purely §3.1.3
// hierarchical-prefix scan locality on the COL chain. (The side tables
// are dimension lookups, not chain participants; the composite-key probe
// is a per-lineitem constant-time hashset lookup, not a fourth join level.)
//
// FILTER PUSHDOWN: every parameterised filter is pushed as far down as
// possible, stopping ONLY at secondary structures. The COL MI, COL
// secondaries, and pipeline view are all loaded UNFILTERED. None of
// `r_name`, the resolved nation_set, or the orderdate window may be
// baked into any secondary (predicate hoisting; PLAYBOOK §3.5 step 7).
//
// PRIMARY-KEY PAYLOAD CONVENTION: every hash build carries the build
// relation's primary key as payload — no record content. Downstream
// consumers fetch additional columns via the primary index at
// consumption time. n_name is the one example: n_name is NOT flowed
// through any intermediate build; it is fetched at result-emission
// time (~5 output rows, ~5 NATION primary-index point lookups).
//
// C++ implementation map (q5/query.tpp + col_pipeline.tpp,
// to be created in Phase 0.5):
//
//   Side reductions (built before pipeline)
//   ───────────────────────────────────────
//   • Scan(REGION) + Filter(r_name == :1)     — 5 rows → 1 regionkey
//   • HashJoin(REGION ⋈ NATION on n_regionkey)— 25 rows → ~5 entries
//                                               → nation_set
//                                                 (unordered_set<n_nationkey>)
//   • SUPPLIER ⋉ nation_set on s_nationkey    — ~10K rows → ~2K entries
//                                               → supplier_nation_set
//                                                 (unordered_set<tuple<
//                                                  n_nationkey, s_suppkey>>)
//
//   Pipeline (custkey-sorted)
//   ─────────────────────────
//   • CUSTOMER ⋉ nation_set on c_nationkey   — semi-join at on_customer;
//                                               returns false to suppress
//                                               group; c_nationkey carried
//                                               on survivors
//   • o_orderdate ∈ window                   — q5_predicate_orders;
//                                               applied at on_order
//   • (c_nationkey, l_suppkey) ∈             — per-lineitem; SKIP if absent
//       supplier_nation_set                    (fuses cross-eq + suppkey join)
//   • HashAggregate(group=[nationkey],        — per-nationkey accumulator
//       revenue = SUM(l_extendedprice          (Visitor carries a small map
//                     * (1 - l_discount)))      keyed by n_nationkey)
//   • n_name resolved at emit time            — ~5 NATION primary-index
//                                               lookups keyed on n_nationkey
//   • Pipeline output                         — q5_pipeline_view_t
//                                               (S2 only) or direct
//                                               q5_agg_row_t emission
//                                               (S1/S3)
//
//   Outside-pipeline (constant across S1/S2/S3 per OPERATORS.md §6.4)
//   ────────────────────────────────────────────────────────────────
//   • Sort (revenue DESC)                     — std::sort over ~5 rows
//   • No LIMIT                                — TPC-H Q5 has no LIMIT
//
// Inside-pipeline physical execution (the S1/S2/S3 comparison axis):
//   S1 → col_secondary_group_walk over CUSTOMER + 2 COL secondaries
//        (orders_sec keyed by (custkey, orderkey); lineitem_sec keyed
//        by (custkey, orderkey, linenumber))
//   S2 → scan q5_pipeline_view_t. The view is loaded UNFILTERED and
//        per-lineitem (one row per (custkey, orderkey, linenumber)
//        carrying l_extendedprice, l_discount, l_suppkey,
//        c_nationkey, o_orderdate). All filters apply live on view
//        rows; the per-nationkey HashAggregate fires above the view
//        scan; n_name resolved at emit time.
//   S3 → col_group_walk over the 3-table COL MergedAdapter
//
// Outside-pipeline operators are byte-identical across the three.

digraph {
  rankdir=BT;

  // ─────────── Shared dimension subtree: RN = REGION ⋈ NATION ───────────
  s_reg [label="TableScan(REGION)\n+ Filter(r_name == :1)\n→ 1 regionkey",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  s_nat [label="TableScan(NATION)",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  rn    [label="HashJoin(REGION ⋈ NATION\n  on n_regionkey = r_regionkey)\ninner join\nbuild payload = n_nationkey only\n(primary-key payload convention;\nno other NATION columns carried)",
         shape=box, style="filled,rounded", fillcolor="#E0F2F1"];

  s_reg -> rn [label="build\n(filtered)"];
  s_nat -> rn [label="probe"];

  // ─────────── Fan-out 1: CUSTOMER ⋉ RN ───────────
  sj_cust [label="HashSemiJoin\n(CUSTOMER ⋉ RN\n  on c_nationkey = n_nationkey)\nno NATION column flows downstream;\nc_nationkey preserved on survivors",
           shape=box, style="filled,rounded", fillcolor="#E8F0FE"];

  rn -> sj_cust [style=dashed, label="nation_set\n(build)"];

  // ─────────── Fan-out 2: SUPPLIER ⋉ RN → composite-key build ───────────
  sj_sup [label="HashSemiJoin\n(SUPPLIER ⋉ RN\n  on s_nationkey = n_nationkey)\nno NATION column flows downstream",
          shape=box, style="filled,rounded", fillcolor="#E0F2F1"];
  bld_sup [label="Build(hashset on (s_nationkey, s_suppkey))\ncomposite key = effective PK of\nrestricted-supplier relation;\nno payload\n[supplier_nation_set]",
           shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  rn     -> sj_sup  [style=dashed, label="nation_set\n(build)"];
  sj_sup -> bld_sup;

  // ─────────── Sources (chain) ───────────
  s_cust [label="TableScan(CUSTOMER)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_ord  [label="TableScan(ORDERS)\n+ Filter(o_orderdate ∈ window)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_lin  [label="TableScan(LINEITEM)",
          shape=box, style=filled, fillcolor="#E8F0FE"];

  s_cust -> sj_cust [label="probe"];

  // ─────────── Inside pipeline (custkey-sorted) ───────────
  joinB [label="MergeJoin(ORDERS ⋈ LINEITEM\n  on (custkey, orderkey))\nstill custkey-sorted (FD via parent)\norders_sec: (custkey, orderkey)\nlineitem_sec: (custkey, orderkey, linenumber)",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];
  joinA [label="MergeJoin(CUSTOMER ⋈ <ord-line>\n  on custkey)\nsorted on custkey;\nc_nationkey preserved on survivors",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  probe_sup [label="Probe supplier_nation_set\n  with (c_nationkey, l_suppkey)\nSKIP if absent\n(fuses: SUPPLIER semi-join,\n c_nationkey = s_nationkey,\n l_suppkey = s_suppkey)",
             shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  agg [label="HashAggregate(group=[n_nationkey],\n  revenue = SUM(l_extendedprice * (1 - l_discount)))\n[NNameRevenueAggregator keyed by nationkey]",
       shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  emit [label="emit(): resolve n_name per nationkey\nvia NATION primary-index lookup\n(~5 output rows, ~5 point lookups)\n→ q5_agg_row_t",
        shape=box, style=filled, fillcolor="#FCE5CD"];

  // ─────────── Outside pipeline ───────────
  sort [label="Sort(revenue DESC)\n[std::sort, ~5 rows]",
        shape=box, style=filled, fillcolor="#E6F4EA"];

  // ─────────── Edges ───────────
  s_ord -> joinB [label="0"];
  s_lin -> joinB [label="1"];

  sj_cust -> joinA [label="0"];
  joinB   -> joinA [label="1"];

  joinA     -> probe_sup;
  bld_sup   -> probe_sup [style=dashed, label="supplier_nation_set\n(lookup)"];
  probe_sup -> agg;

  agg  -> emit;
  emit -> sort;

  // ─────────── Emit-time note ───────────
  note [label="n_name resolved at result-emission time\nvia NATION primary-index lookup;\n~5 output rows → ~5 point lookups.\nNo nation_name_map; no n_name in any build.",
        shape=note, style=filled, fillcolor="#F3E5F5"];
  emit -> note [style=dashed, arrowhead=none];
}
