// Q5 family logical plan — shared by S1, S2, S3.
//
// Departs from Calcite's vanilla Q5 plan in two key ways, mirroring
// Q3's COL-family treatment:
//
//   1. Pipeline sort key is CUSTKEY, not ORDERKEY. ORDERS and LINEITEM
//      secondaries are extended with the custkey FD (orders key
//      `(custkey, orderkey)`, lineitem key `(custkey, orderkey,
//      linenumber)`) so the COL MI's natural sort key is custkey.
//      Per OPERATORS.md §1, the family logical plan must match the COL
//      MI's natural sort key.
//
//   2. Shared RN = REGION ⋈ NATION dimension subtree fans out into
//      two operators with DIFFERENT classes:
//
//         RN shared dimension subtree
//         ───────────────────────────
//         • Filter(r_name = :1) → REGION
//         • HashJoin (inner) REGION ⋈ NATION on n_regionkey = r_regionkey
//             build payload = n_nationkey only (primary-key payload
//             convention — join key = PK of surviving NATION rows;
//             no other columns carried).
//             → RN result
//
//         Fan-out 1 — CUSTOMER ⋈ RN on c_nationkey = n_nationkey
//             HashJoin (INNER). The joined record carries c_nationkey
//             (= matched n_nationkey on survivors), used downstream
//             to fetch n_name via NATION's primary index. Lookup
//             timing is an efficiency choice — the inner-join framing
//             authorizes it anywhere after on_customer (S3) / the
//             customer build (S1/S2/S4). Convention: lazy lookup on
//             first sighting of each new nationkey, cached in the
//             per-nationkey aggregator bucket (~5 lookups per query).
//
//         Fan-out 2 — SUPPLIER ⋉ RN on s_nationkey = n_nationkey
//             HashSemiJoin. No NATION column flows downstream from the
//             supplier arm. Survivors are projected to
//             (s_nationkey, s_suppkey) — composite key, effective PK
//             of the restricted-supplier relation.
//             [supplier_nation_set]
//
//      Asymmetric framing IS the point: operator class is decided by
//      what the joined record carries downstream, not by whether the
//      build payload happens to be empty.
//
// Operator-framing rules (also enforced in baseline_s4.dot and
// family_s3_physical.dot):
//
//   • "Probe X" and "Build X" are NEVER operator nodes — they are
//     edge roles into a HashJoin/HashSemiJoin operator.
//   • Sorted-then-seek loops are HashJoin lowerings (physical
//     implementation, not a separate operator).
//
// The chain itself is identical in shape to Q3's: customer × orders ×
// lineitem in custkey-byte-lex order. Filter pushdown:
//
//   • CUSTOMER ⋈ RN on c_nationkey = n_nationkey → fused with
//                                       TableScan(CUSTOMER)
//                                       (inner join; ~80% prune)
//   • o_orderdate ∈ window           → fused with TableScan(ORDERS)
//   • l_extendedprice * (1-l_discount) → per-lineitem accumulator input
//   • COL ⋉ supplier_nation_set on (c_nationkey, l_suppkey)
//                                    → per-lineitem composite-key
//                                      semi-join; fuses SUPPLIER ⋉ RN,
//                                      cross-equality c_nationkey =
//                                      s_nationkey, and suppkey
//                                      equi-join in one lookup.
//
// Q5 has NO sibling sub-aggregate. The MI benefit is purely §3.1.3
// hierarchical-prefix scan locality on the COL chain. (The side tables
// are dimension lookups, not chain participants; the composite-key
// semi-join is a per-lineitem constant-time hashset lookup, not a
// fourth join level.)
//
// FILTER PUSHDOWN: every parameterised filter is pushed as far down as
// possible, stopping ONLY at secondary structures. The COL MI, COL
// secondaries, and pipeline view are all loaded UNFILTERED. None of
// `r_name`, the resolved nation_set, or the orderdate window may be
// baked into any secondary (predicate hoisting; PLAYBOOK §3.5 step 7).
//
// PRIMARY-KEY PAYLOAD CONVENTION: every hash build carries the build
// relation's primary key as payload — no record content. Downstream
// consumers fetch additional columns via the primary index at
// consumption time. n_name is the canonical example: NOT flowed
// through any intermediate build; lazy NATION PK lookup happens
// INSIDE the chain (downstream of CUSTOMER ⋈ RN), on first sighting
// of each distinct nationkey (~5 lookups per query, cached in the
// per-nationkey aggregator bucket).
//
// C++ implementation map (q5/query.tpp + col_pipeline.tpp):
//
//   Side reductions (built before pipeline)
//   ───────────────────────────────────────
//   • Scan(REGION) + Filter(r_name == :1)        — 5 rows → 1 regionkey
//   • HashJoin(REGION ⋈ NATION on n_regionkey)   — 25 rows → ~5 entries
//                                                  → nation_set
//                                                    (unordered_set<n_nationkey>)
//   • HashSemiJoin(SUPPLIER ⋉ nation_set
//                  on s_nationkey)               — ~10K rows → ~2K entries
//                                                  → supplier_nation_set
//                                                    (unordered_set<tuple<
//                                                     n_nationkey, s_suppkey>>)
//
//   Pipeline (custkey-sorted)
//   ─────────────────────────
//   • CUSTOMER ⋈ nation_set on c_nationkey    — HashJoin (inner) at
//                                                on_customer; suppresses
//                                                group on miss;
//                                                c_nationkey carried on
//                                                survivors
//   • o_orderdate ∈ window                    — q5_predicate_orders;
//                                                applied at on_order
//   • COL ⋉ supplier_nation_set
//       on (c_nationkey, l_suppkey)           — per-lineitem; SKIP if absent
//                                                (fuses cross-eq + suppkey join)
//   • HashAggregate(group=[n_nationkey],       — per-nationkey accumulator
//       revenue = SUM(l_extendedprice           (Visitor carries a small map
//                     * (1 - l_discount)))      keyed by n_nationkey)
//   • n_name resolved inside the chain         — lazy NATION PK lookup
//                                                on first sighting of each
//                                                nationkey; ~5 lookups
//                                                per query, cached in the
//                                                aggregator bucket
//   • Pipeline output                          — q5_pipeline_view_t
//                                                (S2 only) or direct
//                                                q5_agg_row_t emission
//                                                (S1/S3)
//
//   Outside-pipeline (constant across S1/S2/S3 per OPERATORS.md §6.4)
//   ────────────────────────────────────────────────────────────────
//   • Sort (revenue DESC)                      — std::sort over ~5 rows
//   • No LIMIT                                 — TPC-H Q5 has no LIMIT
//
// Inside-pipeline physical execution (the S1/S2/S3 comparison axis):
//   S1 → col_secondary_group_walk over CUSTOMER + 2 COL secondaries
//        (orders_sec keyed by (custkey, orderkey); lineitem_sec keyed
//        by (custkey, orderkey, linenumber))
//   S2 → scan q5_pipeline_view_t. The view is loaded UNFILTERED and
//        per-lineitem (one row per (custkey, orderkey, linenumber)
//        carrying l_extendedprice, l_discount, l_suppkey,
//        c_nationkey, o_orderdate). All filters apply live on view
//        rows; the per-nationkey HashAggregate fires above the view
//        scan; n_name resolved lazily inside the aggregator.
//   S3 → col_group_walk over the 3-table COL MergedAdapter
//
// Outside-pipeline operators are byte-identical across the three.

digraph {
  rankdir=BT;

  // ─────────── Shared dimension subtree: RN = REGION ⋈ NATION ───────────
  s_reg [label="TableScan(REGION)\n+ Filter(r_name == :1)\n→ 1 regionkey",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  s_nat [label="TableScan(NATION)",
         shape=box, style=filled, fillcolor="#E0F2F1"];
  rn    [label="HashJoin (inner)\nREGION ⋈ NATION\n  on n_regionkey = r_regionkey\nbuild payload = n_nationkey only\n(PK payload convention)",
         shape=box, style="filled,rounded", fillcolor="#E0F2F1"];

  s_reg -> rn [label="build (filtered)"];
  s_nat -> rn [label="probe"];

  // ─────────── Fan-out 1: CUSTOMER ⋈ RN (inner) ───────────
  s_cust  [label="TableScan(CUSTOMER)",
           shape=box, style=filled, fillcolor="#E8F0FE"];
  hj_cust [label="HashJoin (inner)\nCUSTOMER ⋈ RN\n  on c_nationkey = n_nationkey\nsurvivors carry c_custkey,\n  c_nationkey (= matched n_nationkey)",
           shape=box, style="filled,rounded", fillcolor="#E8F0FE"];

  rn     -> hj_cust [label="build (nation_set,\nPK-only)"];
  s_cust -> hj_cust [label="probe"];

  // ─────────── Fan-out 2: SUPPLIER ⋉ RN (semi-join) ───────────
  s_sup  [label="TableScan(SUPPLIER)",
          shape=box, style=filled, fillcolor="#E0F2F1"];
  sj_sup [label="HashSemiJoin\nSUPPLIER ⋉ RN\n  on s_nationkey = n_nationkey\nsurvivors projected to\n  (s_nationkey, s_suppkey)\n[supplier_nation_set]",
          shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  rn    -> sj_sup [label="build (nation_set,\nPK-only)"];
  s_sup -> sj_sup [label="probe"];

  // ─────────── Inside pipeline (custkey-sorted chain) ───────────
  s_ord  [label="TableScan(ORDERS)\n+ Filter(o_orderdate ∈ window)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_lin  [label="TableScan(LINEITEM)",
          shape=box, style=filled, fillcolor="#E8F0FE"];

  // The chain joins are MergeJoins in S1/S2/S3 over pre-sorted
  // secondaries (orders_sec on (custkey, orderkey); lineitem_sec on
  // (custkey, orderkey, linenumber)). They are inner joins —
  // columns from both inputs flow downstream.
  joinB [label="MergeJoin (inner)\nORDERS ⋈ LINEITEM\n  on (custkey, orderkey)\nstill custkey-sorted (FD via parent);\norders_sec: (custkey, orderkey)\nlineitem_sec: (custkey, orderkey, linenumber)",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];
  joinA [label="MergeJoin (inner)\n<cust-join> ⋈ <ord-line>\n  on custkey\nsorted on custkey;\nc_nationkey preserved on survivors\nfor the composite-key semi-join below",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  // ─────────── COL × supplier composite-key semi-join ───────────
  // Fuses SUPPLIER ⋉ RN with the cross-equality and the suppkey
  // equi-join into ONE per-lineitem hashset probe.
  sj_col_sup [label="HashSemiJoin\n<col-chain> ⋉ supplier_nation_set\n  on (c_nationkey, l_suppkey)\n     = (s_nationkey, s_suppkey)\nfuses: SUPPLIER ⋉ RN,\n   cross-eq c_nationkey = s_nationkey,\n   suppkey equi-join\nsurvivors: lineitem fields +\n   c_nationkey (for aggregation key)",
              shape=box, style="filled,rounded", fillcolor="#FFF8E1"];

  agg [label="HashAggregate\ngroup = [n_nationkey],\nrevenue = SUM(l_extendedprice\n          * (1 - l_discount))\n[NNameRevenueAggregator keyed by nationkey;\n n_name fetched lazily on first sighting\n of each nationkey via NATION PK lookup,\n cached in the bucket — ~5 lookups total;\n buckets drain to q5_agg_row_t directly]",
       shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  sort [label="Sort(revenue DESC)\n[std::sort, ~5 rows]",
        shape=box, style=filled, fillcolor="#E6F4EA"];

  // ─────────── Edges (chain) ───────────
  s_ord -> joinB [label="0"];
  s_lin -> joinB [label="1"];

  hj_cust -> joinA [label="0"];
  joinB   -> joinA [label="1"];

  joinA  -> sj_col_sup [label="probe (per-lineitem)"];
  sj_sup -> sj_col_sup [label="build\n(supplier_nation_set)"];

  sj_col_sup -> agg;
  agg        -> sort;

}
