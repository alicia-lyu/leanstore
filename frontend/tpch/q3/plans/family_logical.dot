// Q3 family logical plan — shared by S1, S2, S3.
//
// Departs from Calcite's vanilla-Q3 plan in one key way:
//
//   1. Pipeline sort key is CUSTKEY, not ORDERKEY. ORDERS and LINEITEM
//      secondaries are extended with the custkey FD (orders key
//      `(custkey, orderkey)`, lineitem key `(custkey, orderkey,
//      linenumber)`) so the COL MI's natural sort key is custkey.
//      Per OPERATORS.md §1, the family logical plan must match the COL
//      MI's natural sort key.
//
//   2. One SortedAggregate inside the pipeline (per-ORDERKEY revenue),
//      realised in C++ as a namespace-scope accumulator struct
//      (LineitemRevenueAccumulator) consumed by a single Visitor via
//      col_group_walk / col_secondary_group_walk (see
//      family_s3_physical.dot for the S3 specialisation). Q3 has NO
//      sibling sub-aggregate (no invoice / threshold) — that is the
//      Q3I extension.
//
// FILTER PUSHDOWN: every parameterised filter is pushed as far down the
// graph as possible, stopping ONLY at secondary structures (so the COL
// MI and the COL secondaries / pipeline view stay reusable across
// param sets — predicate hoisting, mirroring Q12 §4 / Q3I §3.1.2).
// Specifically:
//
//   • c_mktsegment = SEGMENT          → fused with TableScan(CUSTOMER)
//   • o_orderdate < DATE              → fused with TableScan(ORDERS)
//   • l_shipdate > DATE               → fused with TableScan(LINEITEM)
//
// No filter applies post-join. The only outside-pipeline operators are
// Sort(revenue DESC, orderdate ASC) and Limit 10.
//
// C++ implementation map (q3/query.tpp + col_pipeline.tpp,
// to be created in Phase 0.5):
//
//   Pipeline (custkey-sorted)
//   ─────────────────────────
//   • Scan + per-table Filter (fused)        — q3_predicate_orders,
//                                               q3_predicate_lineitem
//                                               called inline at the
//                                               Visitor's on_* hook;
//                                               c_mktsegment gate in
//                                               on_customer (returns
//                                               false to suppress the
//                                               whole group)
//   • CUSTOMER ⋈ ORDERS ⋈ LINEITEM           — Visitor sequencing:
//                                               on_customer gates the
//                                               group; on_order /
//                                               on_lineitem accumulate
//                                               per orderkey under the
//                                               gate
//   • Per-ORDERKEY SortedAggregate (lineitem)— Visitor::flush_order +
//                                               LineitemRevenueAccumulator,
//                                               reset on each new orderkey
//   • Pipeline output                         — q3_pipeline_view_t
//                                               (one row per (custkey,
//                                                orderkey) carrying revenue
//                                                + FD-attached
//                                                customer/order columns)
//
//   Outside-pipeline (constant across S1/S2/S3 per OPERATORS.md §6.4)
//   ───────────────────────────────────────────────────────────────────
//   • Sort (revenue DESC, orderdate ASC)      — apply_top10 helper using
//                                               std::partial_sort
//   • Limit 10                                — apply_top10 truncate
//
// Inside-pipeline physical execution (the S1/S2/S3 comparison axis):
//   S1 → col_secondary_group_walk over CUSTOMER + 2 COL secondaries
//        (orders_sec keyed by (custkey, orderkey); lineitem_sec keyed
//        by (custkey, orderkey, linenumber))
//   S2 → scan q3_pipeline_view_t (loaded via the same Visitor at load
//        time; populate_q3_view applies pushed-down per-table filters
//        but NOT mktsegment so the view is reusable across SEGMENT param
//        sets — date-filter scope is an open Phase 2 design question)
//   S3 → col_group_walk over the 3-table COL MergedAdapter
//
// Outside-pipeline operators are byte-identical across the three.

digraph {
  rankdir=BT;

  // ─────────── Sources with filters fused ───────────
  // Each TableScan-Filter pair is logically one node; drawn as two for
  // clarity. The filter NEVER applies to secondary-structure loading
  // (the COL MI, COL secondaries, and pipeline view all carry
  // unfiltered base records).
  s_cust [label="TableScan(CUSTOMER)\n+ Filter(c_mktsegment=SEGMENT)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_ord  [label="TableScan(ORDERS)\n+ Filter(o_orderdate < DATE)",
          shape=box, style=filled, fillcolor="#E8F0FE"];
  s_lin  [label="TableScan(LINEITEM)\n+ Filter(l_shipdate > DATE)",
          shape=box, style=filled, fillcolor="#E8F0FE"];

  // ─────────── Inside pipeline (custkey-sorted) ───────────
  // The 3-way custkey-sorted join. In S3 this collapses into a single
  // walker over the merged adapter; in S1 it is a 3-way merge over
  // separate secondary scanners.
  joinA [label="Join(CUSTOMER ⋈ ORDERS, c_custkey = o_custkey)\nsorted on custkey",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];
  joinB [label="Join(⋈ LINEITEM, o_orderkey = l_orderkey)\nstill custkey-sorted (FD via parent)",
         shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  agg_ord [label="SortedAggregate(group=[o_orderkey,\n  o_orderdate, o_shippriority,\n  custkey],\n  revenue = SUM(l_extendedprice * (1 - l_discount)))\n[LineitemRevenueAccumulator]",
           shape=box, style="filled,rounded", fillcolor="#FFF4E5"];

  proj    [label="Project(orderkey, revenue,\n  o_orderdate, o_shippriority)\n→ q3_pipeline_view_t / q3_agg_row_t"];

  // ─────────── Outside pipeline ───────────
  sort     [label="Sort(revenue DESC, orderdate ASC)\n[apply_top10 partial_sort]",
            shape=box, style=filled, fillcolor="#E6F4EA"];
  limit    [label="Limit 10\n[apply_top10 resize]",
            shape=box, style=filled, fillcolor="#E6F4EA"];

  // ─────────── Edges ───────────
  s_cust -> joinA  [label="0"];
  s_ord  -> joinA  [label="1"];

  joinA  -> joinB  [label="0"];
  s_lin  -> joinB  [label="1"];

  joinB -> agg_ord;
  agg_ord -> proj;
  proj  -> sort;
  sort  -> limit;
}
