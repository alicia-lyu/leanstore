// Q3I S3 physical plan — substitutes the family logical plan with a
// single COLIGroupWalk over the 4-table COLI MergedAdapter.
//
// Why one operator replaces five: the COLI MI co-locates CUSTOMER,
// INVOICE, ORDERS, and LINEITEM by custkey using Calcite-style tagged
// keys. Within a custkey group, byte-lex order is:
//
//     customer → invoice* → (orders → lineitem*)+
//
// (after the tag reorder in views_coli.hpp; invoice tag = 2 < orders
// tag = 3, so all invoices arrive before any order). This means a
// single forward streaming pass — no buffering, no hashmaps — can:
//
//   1. Apply the c_mktsegment gate at the customer record
//   2. Accumulate cust_open_due over invoices BEFORE any order arrives
//   3. Maintain a per-orderkey revenue accumulator, flushing at each
//      order boundary
//   4. Apply the threshold filter at flush time
//
// C++ implementation map (q3i/query.tpp::query_by_merged):
//
//   coli_group_walk<Backend>(merged_coli, Visitor{...})
//
//     Visitor::on_customer  → c_mktsegment gate (returns false to
//                             suppress on_invoice/order/lineitem)
//     Visitor::on_invoice   → CustomerOpenDueAccumulator::consume_invoice
//                             (filters i_status='O' inline)
//     Visitor::on_order     → flush_order(); start new orderkey register
//                             if o_orderdate < DATE
//     Visitor::on_lineitem  → LineitemRevenueAccumulator::consume
//                             (filters l_shipdate > DATE inline)
//     Visitor::on_group_end → final flush_order(); reset accumulators
//
//     flush_order()         → emits q3i_agg_row_t IFF
//                             cust_open_due > THRESHOLD (outside-pipeline
//                             threshold filter; OPERATORS.md §3 op 7)
//
// PremergedJoin / BinaryMergeJoin are NOT instantiated here — the COLI
// merged adapter's tagged-key encoding makes the Visitor pattern strictly
// more expressive (4-way custkey grouping with 2 distinct sub-aggregates).
// This is the operator-level expression of the §3.1.2 sibling +
// §3.1.3 hierarchical hybrid pattern.

digraph {
  rankdir=BT;

  mi [label="MergedScanner(MI_COLI)\n= [customer_coli_t, invoice_coli_t,\n   orders_coli_t, lineitem_coli_t]\nkeyed by custkey (tagged keys)",
      shape=box3d, style=filled, fillcolor="#E8F0FE"];

  walk [label="COLIGroupWalk(Visitor)\nsubsumes:\n  • per-table Filters\n  • per-CUSTKEY SortedAggregate (invoice)\n  • CUSTOMER ⋈ ORDERS ⋈ LINEITEM\n  • per-ORDERKEY SortedAggregate (lineitem)\n  • Project → q3i_agg_row_t",
         shape=box, style="filled,rounded", fillcolor="#FCE5CD"];

  out_filt [label="Filter(cust_open_due > THRESHOLD)\nfused in Visitor::flush_order",
            shape=box, style=filled, fillcolor="#E6F4EA"];

  sort  [label="Sort(revenue DESC)\n[apply_top10 partial_sort]",
         shape=box, style=filled, fillcolor="#E6F4EA"];
  limit [label="Limit 10\n[apply_top10 resize]",
         shape=box, style=filled, fillcolor="#E6F4EA"];

  mi    -> walk;
  walk  -> out_filt;
  out_filt -> sort;
  sort  -> limit;
}
